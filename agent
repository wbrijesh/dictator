 actionButtonTapped() {\n        switch currentState {\n        case .idle, .error, .result:\n            delegate?.didTapStopRecording()\n        case .recording:\n            delegate?.didTapStopRecording()\n        case .transcribing:\n            break\n        }\n    }\n    \n    @objc private func copyButtonTapped() {\n        delegate?.didTapCopyText(transcriptionText)\n        \n        let originalTitle = copyButton.title\n        copyButton.title = \"Copied!\"\n        \n        DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {\n            self.copyButton.title = originalTitle\n        }\n    }\n    \n    @objc private func closeButtonTapped() {\n        delegate?.didTapClose()\n    }\n    \n    deinit {\n        DistributedNotificationCenter.default.removeObserver(self)\n    }\n}\n\n// MARK: - Simple Waveform Live View (fallback implementation)\n// This is a simplified version that mimics the DSWaveformImage API\n// In a real implementation, you would use the actual DSWaveformImage library\n\nclass WaveformLiveView: NSView {\n    struct Configuration {\n        enum Style {\n            case striped(NSColor)\n        }\n        \n        struct Dampening {\n            enum Sides {\n                case both\n            }\n            let percentage: Float\n            let sides: Sides\n        }\n        \n        let style: Style\n        let dampening: Dampening\n    }\n    \n    var configuration: Configuration = Configuration(\n        style: .striped(NSColor.controlAccentColor),\n        dampening: Configuration.Dampening(percentage: 0.125, sides: .both)\n    ) {\n        didSet {\n            updateAppearance()\n        }\n    }\n    \n    private var samples: [Float] = []\n    private var maxSamples = 100\n    private var stripeLayers: [CAShapeLayer] = []\n    \n    override init(frame frameRect: NSRect) {\n        super.init(frame: frameRect)\n        setupView()\n    }\n    \n    required init?(coder: NSCoder) {\n        super.init(coder