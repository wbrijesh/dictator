            let x = startX + CGFloat(i) * (barWidth + barSpacing)\n            barLayer.frame = NSRect(x: x, y: bounds.height / 2 - 1, width: barWidth, height: 2)\n            \n            layer?.addSublayer(barLayer)\n            waveformLayers.append(barLayer)\n        }\n    }\n    \n    override func layout() {\n        super.layout()\n        // Recreate waveform when bounds change\n        if !waveformLayers.isEmpty {\n            setupWaveform()\n        }\n    }\n    \n    private func getBarColor() -> NSColor {\n        return NSColor.controlAccentColor\n    }\n    \n    func updateAppearance() {\n        let newColor = getBarColor()\n        waveformLayers.forEach { layer in\n            layer.fillColor = newColor.cgColor\n        }\n    }\n    \n    func updateAudioLevel(_ level: Float) {\n        guard !waveformLayers.isEmpty else {\n            setupWaveform()\n            return\n        }\n        \n        DispatchQueue.main.async { [weak self] in\n            guard let self = self else { return }\n            \n            self.audioLevel = level\n            self.animationPhase += 0.15\n            \n            for (index, layer) in self.waveformLayers.enumerated() {\n                let normalizedIndex = Float(index) / Float(self.numberOfBars - 1)\n                let baseWave = sin(normalizedIndex * Float.pi * 3 + self.animationPhase)\n                let amplitudeModulation = sin(normalizedIndex * Float.pi + self.animationPhase * 0.7)\n                \n                let waveHeight = (baseWave * amplitudeModulation * 0.4 + 0.6) * level\n                let height = max(2, CGFloat(waveHeight * 30 + 2))\n                \n                CATransaction.begin()\n                CATransaction.setAnimationDuration(0.08)\n                CATransaction.setAnimationTimingFunction(CAMediaTimingFunction(name: .easeOut))\n                \n                layer.frame.size.height = height\n                layer.frame.origin.y = (self.bounds.height - height) / 2\n                \n                CATransaction.commit()\n            }\n        }\n    }\n}",
