ercentage)\n                let height = max(2, CGFloat(dampened * 30 + 2))\n                \n                CATransaction.begin()\n                CATransaction.setAnimationDuration(0.1)\n                CATransaction.setAnimationTimingFunction(CAMediaTimingFunction(name: .easeOut))\n                \n                stripe.frame.size.height = height\n                stripe.frame.origin.y = (self.bounds.height - height) / 2\n                \n                CATransaction.commit()\n            }\n        }\n    }\n}",
